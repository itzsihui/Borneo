AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_ENABLED=true
# Optional: AWS_BEARER_TOKEN_BEDROCK=

# Optional fallback if Frankfurter FX is unreachable (Shopify URL import)
# USD_SGD_RATE=1.35

