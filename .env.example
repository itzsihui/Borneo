TOKEN_DECIMALS=6
MERCHANT_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
BUYER_ADDRESS=0x288B8BEd30840d3412d24Bc063391a4Bb1D6AAC3
